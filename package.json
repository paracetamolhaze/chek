{
  "name": "receipts",
  "private": true,
  "type": "module",
  "description": "RECEIPTS ($RCPT) — meme coin project: website, brand, content, owner dashboard",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "node scripts/render-assets.mjs && node scripts/render-content.mjs",
    "dashboard": "node dashboard/server.mjs",
    "build": "npm --prefix website run build",
    "deploy": "node scripts/deploy.mjs",
    "check": "node scripts/prelaunch-check.mjs",
    "schedule": "node scripts/schedule.mjs",
    "shots": "node scripts/shot.mjs",
    "perf": "node scripts/perf.mjs"
  },
